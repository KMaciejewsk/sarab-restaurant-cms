<%- include('partials/header', { title: 'Zarządzanie Rezerwacjami | Sarab CMS' }) %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activeTab: 'reservations' }) %>

<main class="app-main">
  <div class="app-content-header py-3 border-bottom mb-4 bg-white">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-sm-6">
          <h3 class="mb-0 fw-bold"><i class="bi bi-calendar-check text-danger me-2"></i>Rezerwacje Stolików</h3>
          <p class="text-muted small mb-0">Podgląd zgłoszeń nadesłanych przez formularz rezerwacyjny ze strony</p>
        </div>
      </div>
    </div>
  </div>

  <div class="app-content">
    <div class="container-fluid">

      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Wszystkie rezerwacje (<%= reservations.length %>)</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Klient</th>
                  <th>Kontakt</th>
                  <th>Osoby</th>
                  <th>Termin</th>
                  <th>Specjalne życzenia</th>
                  <th>Status</th>
                  <th class="text-end">Zmień status</th>
                </tr>
              </thead>
              <tbody>
                <% if (reservations.length === 0) { %>
                  <tr><td colspan="7" class="text-center py-4 text-muted">Brak rezerwacji w systemie.</td></tr>
                <% } else { %>
                  <% reservations.forEach(r => { %>
                    <tr>
                      <td>
                        <strong><%= r.full_name %></strong>
                      </td>
                      <td>
                        <small class="d-block"><i class="bi bi-telephone text-muted me-1"></i><%= r.phone %></small>
                        <small class="d-block text-muted"><i class="bi bi-envelope text-muted me-1"></i><%= r.email %></small>
                      </td>
                      <td>
                        <span class="badge text-bg-light border px-2 py-1"><%= r.guests %> os.</span>
                      </td>
                      <td>
                        <strong><%= r.reservation_date %></strong><br />
                        <small class="text-danger fw-semibold"><%= r.reservation_time %></small>
                      </td>
                      <td style="max-width: 250px;">
                        <small class="text-muted"><%= r.special_requests || 'Brak uwag' %></small>
                      </td>
                      <td>
                        <% if (r.status === 'confirmed') { %>
                          <span class="badge text-bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i> Potwierdzona</span>
                        <% } else if (r.status === 'cancelled') { %>
                          <span class="badge text-bg-danger px-2 py-1"><i class="bi bi-x-circle me-1"></i> Odrzucona</span>
                        <% } else if (r.status === 'completed') { %>
                          <span class="badge text-bg-secondary px-2 py-1"><i class="bi bi-flag me-1"></i> Zakończona</span>
                        <% } else { %>
                          <span class="badge text-bg-warning px-2 py-1"><i class="bi bi-hourglass-split me-1"></i> Oczekująca</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <div class="btn-group btn-group-sm">
                          <form action="/admin/reservations/status/<%= r.id %>" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="confirmed" />
                            <button type="submit" class="btn btn-outline-success" title="Potwierdź"><i class="bi bi-check-lg"></i></button>
                          </form>
                          <form action="/admin/reservations/status/<%= r.id %>" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="cancelled" />
                            <button type="submit" class="btn btn-outline-danger" title="Odrzuć"><i class="bi bi-x-lg"></i></button>
                          </form>
                          <form action="/admin/reservations/status/<%= r.id %>" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="completed" />
                            <button type="submit" class="btn btn-outline-secondary" title="Oznacz jako zakończoną"><i class="bi bi-archive"></i></button>
                          </form>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>
