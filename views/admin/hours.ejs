<%- include('partials/header', { title: 'Godziny Otwarcia | Sarab CMS' }) %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activeTab: 'hours' }) %>

<main class="app-main">
  <div class="app-content-header py-3 border-bottom mb-4 bg-white">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-sm-6">
          <h3 class="mb-0 fw-bold"><i class="bi bi-clock-history text-danger me-2"></i>Godziny Otwarcia Restauracji</h3>
          <p class="text-muted small mb-0">Zmień godziny pracy lokalu wyświetlane na stronie głównej, w kontakcie i rezerwacjach</p>
        </div>
      </div>
    </div>
  </div>

  <div class="app-content">
    <div class="container-fluid">
      <div class="row justify-content-center">
        <div class="col-lg-8">

          <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
              <i class="bi bi-check-circle me-1"></i> <%= success %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3">
              <h5 class="card-title fw-bold mb-0">Harmonogram tygodniowy</h5>
            </div>
            <form action="/admin/hours/update" method="POST" class="card-body p-4">
              <div class="table-responsive">
                <table class="table align-middle mb-4">
                  <thead class="table-light">
                    <tr>
                      <th style="width: 35%;">Dzień / Zakres dni</th>
                      <th style="width: 45%;">Godziny otwarcia</th>
                      <th style="width: 20%;" class="text-center">Zamknięte?</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% openingHours.forEach(h => { %>
                      <tr>
                        <td>
                          <strong><%= h.day_range %></strong>
                          <input type="hidden" name="id[]" value="<%= h.id %>" />
                          <input type="hidden" name="day_range[]" value="<%= h.day_range %>" />
                        </td>
                        <td>
                          <input type="text" name="hours[]" class="form-control" value="<%= h.hours %>" placeholder="np. 09:00 AM - 11:00 PM" required />
                        </td>
                        <td class="text-center">
                          <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input" type="checkbox" name="is_closed_<%= h.id %>" value="1" <%= h.is_closed ? 'checked' : '' %> />
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>

              <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-sarab px-4">
                  <i class="bi bi-check-lg me-1"></i> Zapisz godziny otwarcia
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
