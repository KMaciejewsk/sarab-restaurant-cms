<%- include('partials/header', { title: 'Opinie i Recenzje | Sarab CMS' }) %>
<%- include('partials/navbar') %>
<%- include('partials/sidebar', { activeTab: 'reviews' }) %>

<main class="app-main">
  <div class="app-content-header py-3 border-bottom mb-4 bg-white">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-sm-6">
          <h3 class="mb-0 fw-bold"><i class="bi bi-star text-warning me-2"></i>Opinie i Recenzje Klientów</h3>
          <p class="text-muted small mb-0">Moderacja recenzji dodanych na stronie przez gości restauracji (wymóg: Właściciel)</p>
        </div>
      </div>
    </div>
  </div>

  <div class="app-content">
    <div class="container-fluid">

      <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3">
          <h5 class="card-title fw-bold mb-0">Wszystkie recenzje (<%= reviews.length %>)</h5>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Klient</th>
                  <th>Ocena</th>
                  <th>Treść opinii</th>
                  <th>Data dodania</th>
                  <th>Status publikacji</th>
                  <th class="text-end">Akcje moderacji</th>
                </tr>
              </thead>
              <tbody>
                <% if (reviews.length === 0) { %>
                  <tr><td colspan="6" class="text-center py-4 text-muted">Brak opinii w bazie danych.</td></tr>
                <% } else { %>
                  <% reviews.forEach(rev => { %>
                    <tr class="<%= rev.is_approved ? '' : 'table-warning' %>">
                      <td>
                        <strong><%= rev.author_name %></strong><br />
                        <small class="text-muted"><%= rev.role_or_city %></small>
                      </td>
                      <td>
                        <span class="text-warning fw-bold fs-6">
                          <% for (let i = 0; i < rev.rating; i++) { %>★<% } %>
                        </span>
                        <small class="text-muted d-block"><%= rev.rating %>/5</small>
                      </td>
                      <td style="max-width: 350px;">
                        <p class="mb-0 small"><%= rev.comment %></p>
                      </td>
                      <td>
                        <small class="text-muted"><%= rev.created_at %></small>
                      </td>
                      <td>
                        <% if (rev.is_approved) { %>
                          <span class="badge text-bg-success px-2 py-1"><i class="bi bi-eye me-1"></i> Opublikowana na stronie</span>
                        <% } else { %>
                          <span class="badge text-bg-warning px-2 py-1"><i class="bi bi-hourglass-split me-1"></i> Oczekuje na akceptację</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <% if (!rev.is_approved) { %>
                          <form action="/admin/reviews/approve/<%= rev.id %>" method="POST" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success me-1" title="Zatwierdź i opublikuj na stronie">
                              <i class="bi bi-check-lg me-1"></i> Zatwierdź
                            </button>
                          </form>
                        <% } %>
                        <form action="/admin/reviews/delete/<%= rev.id %>" method="POST" class="d-inline" onsubmit="return confirm('Czy na pewno chcesz usunąć tę opinię?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Usuń trwale">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div>
</main>

<%- include('partials/footer') %>
