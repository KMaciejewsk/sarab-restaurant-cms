<%- include('partials/header') %>
<%- include('partials/banner', { pageTitle: 'Meet Our Culinary Masters', subtitle: 'The Team Behind The Flavor', breadcrumb: 'Chefs' }) %>

<section id="chefs">
   <div class="container">
      <div class="text-center mb-5" data-aos="fade-up">
         <span class="slbl">The Culinary Team</span>
         <h2 class="stitle">Meet Our Expert <span>Chefs</span></h2>
         <div class="sline"></div>
      </div>
      <div class="row g-4">
         <% chefs.forEach((chef, idx) => { %>
            <div class="col-sm-6 col-lg-3" data-aos="fade-up" data-aos-delay="<%= idx * 80 %>">
               <div class="chcard">
                  <div class="chimg">
                     <img src="<%= chef.image %>" alt="<%= chef.name %>"/>
                     <div class="chsoc">
                        <a href="<%= chef.instagram_url || '#' %>"><i class="fab fa-instagram"></i></a>
                        <a href="<%= chef.facebook_url || '#' %>"><i class="fab fa-facebook-f"></i></a>
                        <a href="<%= chef.twitter_url || '#' %>"><i class="fab fa-twitter"></i></a>
                     </div>
                  </div>
                  <div class="chbody">
                     <div class="chnm"><%= chef.name %></div>
                     <div class="chrole"><%= chef.role %></div>
                     <div class="chexp"><%= chef.experience %></div>
                     <% if (chef.bio) { %>
                        <p class="small text-muted mt-2 mb-0"><%= chef.bio %></p>
                     <% } %>
                  </div>
               </div>
            </div>
         <% }) %>
      </div>
   </div>
</section>

<div class="py-5 text-center bg-light">
   <div class="container">
      <h3 class="mb-3">Passionate About Cooking?</h3>
      <p class="text-muted mb-4">We are always looking for talented chefs and kitchen staff to join our growing family.</p>
      <a href="/contact" class="btn-red"><i class="fas fa-paper-plane me-1"></i>Contact Careers</a>
   </div>
</div>

<%- include('partials/footer') %>
